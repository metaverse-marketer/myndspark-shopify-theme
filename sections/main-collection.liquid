{% schema %}
{
  "name": "Collection",
  "settings": []
}
{% endschema %}

<section style="padding: 48px 0 80px;">
  <div class="container">
    <h1 style="font-size: 36px; margin-bottom: 32px;">{{ collection.title | default: 'All Products' }}</h1>

    <div class="showcase-grid">
      {% for product in collection.products %}
        <div class="showcase-card">
          <a href="{{ product.url }}" class="showcase-card__image">
            {% if product.featured_image %}
              <img src="{{ product.featured_image | image_url: width: 600 }}" alt="{{ product.title | escape }}" loading="lazy">
            {% else %}
              <img src="{{ 'whole-kit.png' | asset_url }}" alt="{{ product.title | escape }}" loading="lazy">
            {% endif %}
          </a>
          <div class="showcase-card__content">
            <h3><a href="{{ product.url }}">{{ product.title }}</a></h3>
            <p style="margin-bottom: 12px;">{{ product.description | strip_html | truncate: 100 }}</p>
            <div style="display: flex; align-items: center; justify-content: space-between;">
              <span style="font-family: var(--font-heading); font-weight: 700; font-size: 20px; color: var(--color-primary);">{{ product.price | money }}</span>
              <a href="{{ product.url }}" class="btn btn--primary" style="padding: 8px 20px; font-size: 14px;">View</a>
            </div>
          </div>
        </div>
      {% endfor %}
    </div>
  </div>
</section>
