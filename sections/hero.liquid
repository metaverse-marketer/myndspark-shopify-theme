{% schema %}
{
  "name": "Hero",
  "settings": [
    {
      "type": "text",
      "id": "badge",
      "label": "Badge Text",
      "default": "Cognitive Efficiency Tool"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "A multisensory approach to improving brain function"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "The complete at-home cognitive rehabilitation kit. 100+ hands-on activities targeting all 6 brain functions. No screens required."
    },
    {
      "type": "text",
      "id": "primary_cta_text",
      "label": "Primary Button Text",
      "default": "Get Your Kit — $210"
    },
    {
      "type": "url",
      "id": "primary_cta_url",
      "label": "Primary Button URL"
    },
    {
      "type": "text",
      "id": "secondary_cta_text",
      "label": "Secondary Button Text",
      "default": "How It Works"
    },
    {
      "type": "url",
      "id": "secondary_cta_url",
      "label": "Secondary Button URL"
    },
    {
      "type": "image_picker",
      "id": "hero_image",
      "label": "Hero Image"
    }
  ],
  "presets": [{ "name": "Hero" }]
}
{% endschema %}

<section class="hero">
  <div class="container">
    <div class="hero__inner">
      <div class="hero__content">
        <span class="hero__badge">{{ section.settings.badge }}</span>
        <h1>{{ section.settings.heading }}</h1>
        <p class="hero__subtitle">{{ section.settings.subtitle }}</p>

        <div class="hero__ctas">
          <a href="{{ section.settings.primary_cta_url | default: '/products/myndspark-cognitive-efficiency-tool' }}" class="btn btn--primary btn--large">
            {{ section.settings.primary_cta_text }}
          </a>
          <a href="{{ section.settings.secondary_cta_url | default: '#how-it-works' }}" class="btn btn--secondary btn--large">
            {{ section.settings.secondary_cta_text }}
          </a>
        </div>

        <div class="hero__trust">
          <div class="hero__trust-item">
            <span class="hero__trust-check">✓</span> 90% symptom improvement
          </div>
          <div class="hero__trust-item">
            <span class="hero__trust-check">✓</span> No screens needed
          </div>
          <div class="hero__trust-item">
            <span class="hero__trust-check">✓</span> Clinically proven
          </div>
        </div>
      </div>

      <div class="hero__image">
        {% if section.settings.hero_image %}
          <img src="{{ section.settings.hero_image | image_url: width: 900 }}"
               srcset="{{ section.settings.hero_image | image_url: width: 600 }} 600w, {{ section.settings.hero_image | image_url: width: 900 }} 900w, {{ section.settings.hero_image | image_url: width: 1200 }} 1200w"
               sizes="(max-width: 900px) 100vw, 50vw"
               alt="Myndspark Cognitive Efficiency Tool Kit"
               width="900" height="600"
               loading="eager">
        {% else %}
          <img src="{{ 'whole-kit.png' | asset_url }}" alt="Myndspark Cognitive Efficiency Tool Kit" loading="eager" onerror="this.src='https://i0.wp.com/myndspark.com/wp-content/uploads/2022/04/CogET_Whole-Kit-1.png?resize=1200%2C800&ssl=1'">
        {% endif %}}
      </div>
    </div>
  </div>
</section>
