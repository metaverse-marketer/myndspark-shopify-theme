{% comment %}
  Reusable six-function color legend chips.
  Usage: {% render 'function-chips' %}
{% endcomment %}
<div class="fn-chips">
  <span class="fn-chip"><span class="fn-chip__dot" style="background: var(--fn-attention);"></span>Attention</span>
  <span class="fn-chip"><span class="fn-chip__dot" style="background: var(--fn-memory);"></span>Memory</span>
  <span class="fn-chip"><span class="fn-chip__dot" style="background: var(--fn-logic);"></span>Logic &amp; Reasoning</span>
  <span class="fn-chip"><span class="fn-chip__dot" style="background: var(--fn-speech);"></span>Speech &amp; Language</span>
  <span class="fn-chip"><span class="fn-chip__dot" style="background: var(--fn-motor);"></span>Motor &amp; Balance</span>
  <span class="fn-chip"><span class="fn-chip__dot" style="background: var(--fn-visual);"></span>Visual Processing</span>
</div>
