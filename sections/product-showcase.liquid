{% schema %}
{
  "name": "Product Showcase",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "What's Inside the Kit"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Everything you need to target all 6 cognitive functions"
    }
  ],
  "presets": [{ "name": "Product Showcase" }]
}
{% endschema %}

<section class="product-showcase">
  <div class="container">
    <div class="section-header">
      <h2>{{ section.settings.heading }}</h2>
      <p>{{ section.settings.subheading }}</p>
    </div>

    <div class="showcase-grid">
      <div class="showcase-card">
        <div class="showcase-card__image">
          <img src="{{ 'blocks-cards.png' | asset_url }}" alt="Logic, Reasoning, Speech & Language activities" loading="lazy" onerror="this.src='https://i0.wp.com/myndspark.com/wp-content/uploads/2022/04/CogET_Blocks-Cards.png?w=1200&ssl=1'">
        </div>
        <div class="showcase-card__content">
          <h3>Logic / Reasoning &amp; Speech / Language</h3>
          <p>Block set designed for deductive reasoning with specific cards and cut-out instructions for each task.</p>
        </div>
      </div>

      <div class="showcase-card">
        <div class="showcase-card__image">
          <img src="{{ 'booklet.png' | asset_url }}" alt="Attention and Memory workbook" loading="lazy" onerror="this.src='https://i0.wp.com/myndspark.com/wp-content/uploads/2022/04/CogET_Booklet.png?w=1200&ssl=1'">
        </div>
        <div class="showcase-card__content">
          <h3>Attention &amp; Memory</h3>
          <p>Workbook to guide you through every step. Sets of cards dedicated to each section's focus areas.</p>
        </div>
      </div>

      <div class="showcase-card">
        <div class="showcase-card__image">
          <img src="{{ 'brock-string.png' | asset_url }}" alt="Motor, Balance & Visual Processing activities" loading="lazy" onerror="this.src='https://i0.wp.com/myndspark.com/wp-content/uploads/2022/04/CogET_Brock-String.png?w=1200&ssl=1'">
        </div>
        <div class="showcase-card__content">
          <h3>Motor / Balance &amp; Visual Processing</h3>
          <p>Brock string and puzzle pieces designed for visual processing and perception oriented tasks.</p>
        </div>
      </div>
    </div>
  </div>
</section>
