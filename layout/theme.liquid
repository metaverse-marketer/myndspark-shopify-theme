<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  <meta http-equiv="X-UA-Compatible" content="IE=edge">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0">
  <meta name="theme-color" content="{{ settings.color_primary }}">
  <link rel="canonical" href="{{ canonical_url }}">

  {%- if settings.favicon != blank -%}
    <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
  {%- endif -%}

  {%- if page_description -%}
    <meta name="description" content="{{ page_description | escape }}">
  {%- endif -%}

  <title>{{ page_title }}{% if current_tags %} &ndash; {{ 'general.meta.tags' | t: tags: current_tags | join: ', ' }}{% endif %}{% if current_page != 1 %} &ndash; {{ 'general.meta.page' | t: page: current_page }}{% endif %}{% unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless %}</title>

  {{ content_for_header }}

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Hanken+Grotesk:wght@400;500;600;700;800&family=IBM+Plex+Mono:wght@400;500;600&display=swap" rel="stylesheet">

  {{ 'myndspark.css' | asset_url | stylesheet_tag }}

  {% comment %}Design tokens — rendered here because .css assets don't process Liquid{% endcomment %}
  <style>
    :root {
      --color-primary: {{ settings.color_primary | default: '#2E4CC8' }};
      --color-primary-dark: {{ settings.color_primary_dark | default: '#1F379E' }};
      --color-secondary: {{ settings.color_secondary | default: '#3DB8AB' }};
      --color-accent: {{ settings.color_accent | default: '#E8B23A' }};
      --color-bg: {{ settings.color_bg_light | default: '#FAFBFE' }};
      --color-text: {{ settings.color_text | default: '#23283A' }};
      --color-text-light: {{ settings.color_text_light | default: '#565B73' }};
      --color-white: {{ settings.color_white | default: '#FFFFFF' }};
      --color-border: {{ settings.color_border | default: '#E7EAF2' }};
      --color-tint: {{ settings.color_tint | default: '#EEF1FB' }};
      --color-dark: {{ settings.color_dark | default: '#16265A' }};
      --color-darker: {{ settings.color_darker | default: '#10193A' }};
      --font-heading: 'Hanken Grotesk', system-ui, sans-serif;
      --font-body: 'Hanken Grotesk', system-ui, sans-serif;
      --font-mono: 'IBM Plex Mono', ui-monospace, monospace;
    }
    .site-header__logo img { max-width: {{ settings.logo_width | default: 160 }}px; height: auto; }
  </style>

  <script>
    document.documentElement.className = document.documentElement.className.replace('no-js', 'js');
    window.theme = {
      strings: {
        addToCart: {{ 'products.product.add_to_cart' | t | json }},
        soldOut: {{ 'products.product.sold_out' | t | json }},
        unavailable: {{ 'products.product.unavailable' | t | json }}
      },
      moneyFormat: {{ shop.money_format | json }}
    };
  </script>
</head>

<body class="template-{{ template.name | handle }}">
  {% comment %}SVG icon sprite — loaded once, referenced via <use href="#icon-name">{% endcomment %}
  {% render 'icon-sprite' %}

  <a class="skip-to-content" href="#MainContent">Skip to content</a>

  {% sections 'site-header' %}

  <main id="MainContent" class="main-content" role="main">
    {{ content_for_layout }}
  </main>

  {% sections 'footer-group' %}

  <script src="{{ 'theme.js' | asset_url }}" defer></script>
</body>
</html>
