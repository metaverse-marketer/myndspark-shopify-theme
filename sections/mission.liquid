{% schema %}
{
  "name": "Mission",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Our Mission"
    },
    {
      "type": "image_picker",
      "id": "mission_image",
      "label": "Mission Image"
    }
  ],
  "presets": [{ "name": "Mission" }]
}
{% endschema %}

<section class="mission">
  <div class="container">
    <div class="mission__inner">
      <div class="mission__image">
        {% if section.settings.mission_image %}
          <img src="{{ section.settings.mission_image | image_url: width: 700 }}" alt="Myndspark Kit" loading="lazy">
        {% else %}
          <img src="{{ 'box-booklets.png' | asset_url }}" alt="Myndspark Kit Contents" loading="lazy">
        {% endif %}
      </div>

      <div class="mission__content">
        <h2>{{ section.settings.heading }}</h2>
        <p>To help individuals with general cognitive decline, neurological impairments from mild to moderate brain injury, stroke, dementia, and learning disabilities to lessen symptoms and improve cognitive efficiency.</p>
        <p>Our mission is to create effective multi-sensory activities that target as many parts of the brain as possible, creating new neurological connections throughout the brain to improve cognitive efficiency.</p>

        <div class="mission__stats">
          <div class="mission__stat">
            <div class="stat-number">100+</div>
            <div class="stat-label">Activities</div>
          </div>
          <div class="mission__stat">
            <div class="stat-number">6</div>
            <div class="stat-label">Brain Functions</div>
          </div>
          <div class="mission__stat">
            <div class="stat-number">90%</div>
            <div class="stat-label">Improvement Rate</div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
