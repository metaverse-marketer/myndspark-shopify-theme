{% schema %}
{
  "name": "Header",
  "settings": [],
  "presets": [{ "name": "Header" }]
}
{% endschema %}

<header class="site-header">
  <div class="site-header__inner">
    <a href="/" class="site-header__logo">
      {% if settings.logo %}
        <img src="{{ settings.logo | image_url: width: settings.logo_width }}"
             srcset="{{ settings.logo | image_url: width: settings.logo_width, scale: 2 }} 2x"
             alt="{{ shop.name }}"
             width="{{ settings.logo_width }}"
             loading="eager">
      {% else %}
        <span style="font-family: var(--font-heading); font-size: 24px; font-weight: 700; color: var(--color-primary);">Myndspark</span>
      {% endif %}
    </a>

    <nav>
      <ul class="site-nav" id="primaryNav">
        <li><a href="/" class="{% if template == 'index' %}active{% endif %}">Home</a></li>
        <li><a href="/products/myndspark-cognitive-efficiency-tool" class="{% if template contains 'product' %}active{% endif %}">The Tool</a></li>
        <li><a href="/pages/about" class="{% if template contains 'about' %}active{% endif %}">About</a></li>
        <li><a href="/pages/contact" class="{% if template contains 'contact' %}active{% endif %}">Contact</a></li>
        <li><a href="/blogs/news">Blog</a></li>
      </ul>
    </nav>

    <div class="header-actions">
      <a href="/cart" class="cart-link">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="9" cy="21" r="1"></circle>
          <circle cx="20" cy="21" r="1"></circle>
          <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path>
        </svg>
        <span class="cart-count" id="CartCount">{{ cart.item_count }}</span>
      </a>
      <button class="mobile-nav-toggle" id="MobileNavToggle" aria-label="Toggle menu">☰</button>
    </div>
  </div>
</header>

<script>
  document.getElementById('MobileNavToggle')?.addEventListener('click', function() {
    document.getElementById('primaryNav').classList.toggle('open');
  });
</script>
