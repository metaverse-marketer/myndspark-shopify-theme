{% schema %}
{
  "name": "Cart",
  "settings": []
}
{% endschema %}

<section style="padding: 48px 0 80px;">
  <div class="container">
    <h1 style="font-size: 36px; margin-bottom: 32px;">Shopping Cart</h1>

    {% if cart.item_count > 0 %}
      <form action="/cart" method="post" id="cartForm">
        <div style="overflow-x: auto;">
          <table style="width: 100%; border-collapse: collapse;">
            <thead>
              <tr style="border-bottom: 2px solid #E8F0EE;">
                <th style="text-align: left; padding: 16px 0;">Product</th>
                <th style="text-align: center; padding: 16px 0;">Quantity</th>
                <th style="text-align: right; padding: 16px 0;">Price</th>
                <th style="text-align: right; padding: 16px 0;">Total</th>
              </tr>
            </thead>
            <tbody>
              {% for item in cart.items %}
              <tr style="border-bottom: 1px solid #E8F0EE;">
                <td style="padding: 20px 0;">
                  <div style="display: flex; gap: 16px; align-items: center;">
                    {% if item.image %}
                      <img src="{{ item.image | image_url: width: 100 }}" alt="{{ item.title | escape }}" style="width: 80px; border-radius: 8px;">
                    {% endif %}
                    <div>
                      <div style="font-weight: 600;"><a href="{{ item.url }}">{{ item.product.title }}</a></div>
                      {% unless item.variant.title contains 'Default' %}
                        <div style="font-size: 14px; color: var(--color-text-light);">{{ item.variant.title }}</div>
                      {% endunless %}
                    </div>
                  </div>
                </td>
                <td style="text-align: center;">
                  <div class="qty-selector" style="display: inline-flex;">
                    <button type="button" onclick="updateQty({{ forloop.index }}, -1)">−</button>
                    <input type="number" name="updates[]" value="{{ item.quantity }}" min="0" id="updates_{{ forloop.index }}" style="width: 50px;">
                    <button type="button" onclick="updateQty({{ forloop.index }}, 1)">+</button>
                  </div>
                </td>
                <td style="text-align: right; white-space: nowrap;">{{ item.price | money }}</td>
                <td style="text-align: right; white-space: nowrap; font-weight: 700;">{{ item.final_line_price | money }}</td>
              </tr>
              {% endfor %}
            </tbody>
          </table>
        </div>

        <div style="display: flex; justify-content: flex-end; margin-top: 32px;">
          <div style="width: 100%; max-width: 400px;">
            <div style="display: flex; justify-content: space-between; padding: 12px 0; font-size: 18px;">
              <span>Subtotal</span>
              <span style="font-weight: 700;">{{ cart.total_price | money }}</span>
            </div>
            <div style="display: flex; justify-content: space-between; padding: 4px 0; font-size: 14px; color: var(--color-text-light); margin-bottom: 20px;">
              <span>Shipping</span>
              <span>Calculated at checkout</span>
            </div>
            <button type="submit" name="checkout" class="btn btn--primary btn--large btn--full">Proceed to Checkout</button>
            <a href="/" style="display: block; text-align: center; margin-top: 12px; font-size: 14px;">Continue Shopping</a>
          </div>
        </div>
      </form>
    {% else %}
      <div style="text-align: center; padding: 80px 0;">
        <p style="font-size: 20px; color: var(--color-text-light); margin-bottom: 24px;">Your cart is empty.</p>
        <a href="/products/myndspark-cognitive-efficiency-tool" class="btn btn--primary btn--large">Shop the Cognitive Tool</a>
      </div>
    {% endif %}
  </div>
</section>

<script>
  function updateQty(index, change) {
    var input = document.getElementById('updates_' + index);
    var newVal = parseInt(input.value) + change;
    if (newVal >= 0) {
      input.value = newVal;
      document.getElementById('cartForm').submit();
    }
  }
</script>
